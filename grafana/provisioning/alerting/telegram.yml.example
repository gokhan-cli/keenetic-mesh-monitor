apiVersion: 1

# Telegram bildirimleri. Bu dosyayı telegram.yml adıyla kopyalayın ve chatid'yi
# kendi sohbet numaranızla değiştirin (telegram.yml git'e girmez).
# Bot token'ı .env'den gelir (TELEGRAM_BOT_TOKEN).
# Sohbet numarası burada yazılı: Grafana ortam değişkeninden gelen sayısal
# değeri sayıya çeviriyor, chatid alanı ise metin bekliyor. Numara tek başına
# gizli değildir; token olmadan işe yaramaz.
# Grafana provisioning'de $X ortam değişkeni demektir; şablonlarda $ kullanılmadığı
# için kaçış gerekmez.

templates:
  - orgId: 1
    name: telegram-tr
    template: |
      {{ define "telegram.tr" }}{{ range .Alerts }}{{ if eq .Status "firing" }}{{ .Annotations.summary }}
      {{ .Annotations.description }}{{ else }}✅ Düzeldi: {{ .Annotations.summary }}{{ end }}
      {{ end }}{{ end }}

contactPoints:
  - orgId: 1
    name: Telegram
    receivers:
      - uid: telegram
        type: telegram
        disableResolveMessage: false
        settings:
          bottoken: $TELEGRAM_BOT_TOKEN
          chatid: "SOHBET_NUMARANIZ"
          parse_mode: None
          message: '{{ template "telegram.tr" . }}'

  # Olay bildirimleri (ör. eve geliş): yalnız bir kez gönderilir, "Düzeldi" mesajı gelmez
  - orgId: 1
    name: Telegram (tek sefer)
    receivers:
      - uid: telegram-once
        type: telegram
        disableResolveMessage: true
        settings:
          bottoken: $TELEGRAM_BOT_TOKEN
          chatid: "SOHBET_NUMARANIZ"
          parse_mode: None
          message: '{{ template "telegram.tr" . }}'

policies:
  - orgId: 1
    receiver: Telegram
    group_by: ["alertname", "device", "name"]
    group_wait: 30s
    group_interval: 5m
    repeat_interval: 24h
    routes:
      # Eve geliş bildirimi: tek mesaj
      - receiver: Telegram (tek sefer)
        object_matchers:
          - ["notify", "=", "once"]
      # Güncelleme bildirimi haftada bir hatırlatılsın
      - receiver: Telegram
        object_matchers:
          - ["severity", "=", "info"]
        repeat_interval: 168h
