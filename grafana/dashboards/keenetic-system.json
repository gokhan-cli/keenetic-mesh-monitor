{
  "uid": "keenetic-system",
  "title": "Keenetic · Sistem ve yazılım",
  "tags": [
    "keenetic"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 30,
      "type": "row",
      "title": "Yazılım",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 31,
      "type": "table",
      "title": "Kurulu yazılım ve güncelleme durumu",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Her cihazın takip ettiği kanal (Sistem → Güncelleme) ve o kanalda yeni sürüm olup olmadığı. Saatte bir kontrol edilir (FIRMWARE_INTERVAL).",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true,
          "expr": "max by (device, channel, title, installed) (keenetic_firmware_info)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true,
          "expr": "max by (device, channel, available) (keenetic_firmware_update_available)"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true
            },
            "indexByName": {
              "device": 0,
              "channel": 1,
              "title": 2,
              "installed": 3,
              "available": 4,
              "Value #B": 5
            },
            "renameByName": {
              "device": "Cihaz",
              "channel": "Kanal",
              "title": "Kurulu",
              "installed": "Kurulu sürüm",
              "available": "Kanaldaki son sürüm",
              "Value #B": "Durum"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Cihaz"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Durum"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "Güncelleme var",
                        "color": "orange"
                      },
                      "0": {
                        "text": "Güncel",
                        "color": "green"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 32,
      "type": "table",
      "title": "Kanallardaki son sürümler",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "LTS / Kararlı / Önizleme / Geliştirici kanallarındaki son sürüm. 'Daha yeni' = cihazda kurulu olandan yeni.",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true,
          "expr": "max by (device, channel, sandbox, version) (keenetic_firmware_channel_newer)"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "device": 0,
              "channel": 1,
              "sandbox": 2,
              "version": 3,
              "Value": 4
            },
            "renameByName": {
              "device": "Cihaz",
              "channel": "Kanal",
              "sandbox": "API adı",
              "version": "Son sürüm",
              "Value": "Kurulu olana göre"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Cihaz"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Kurulu olana göre"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "Daha yeni",
                        "color": "orange"
                      },
                      "0": {
                        "text": "—",
                        "color": "green"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 15,
      "type": "row",
      "title": "Cihaz sistemi",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "CPU",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 9,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "keenetic_system_cpu_load_percent",
          "legendFormat": "{{device}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Cihaz başına CPU yükü (router'ın son ~30 sn ortalaması)."
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Bellek",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 9,
        "y": 9,
        "w": 9,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "keenetic_system_memory_used_bytes / keenetic_system_memory_total_bytes * 100",
          "legendFormat": "{{device}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 46,
      "type": "table",
      "title": "Açık kalma süresi",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 9,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (device, text) (keenetic_system_uptime_text)",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Cihazın son yeniden başlatmadan beri açık kalma süresi. Yeniden başlayınca Telegram uyarısı gelir.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "indexByName": {
              "device": 0,
              "text": 1
            },
            "renameByName": {
              "device": "Cihaz",
              "text": "Açık kalma süresi"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Cihaz"
              }
            ]
          }
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Ethernet port hızları (Mbps, 0=kapalı)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 14,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "keenetic_mesh_port_speed_mbps or (keenetic_mesh_port_link_up * 0)",
          "legendFormat": "{{name}} port {{port}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Mbits",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "min",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 61,
      "type": "row",
      "title": "Servisler",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 62,
      "type": "table",
      "title": "Servisler ve süreçler (seçili aralıkta çalışanlar)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Router'ların süreç listesinden (show processes). Tür: Servis = KeeneticOS'un yönettiği servis; Süreç = servis olmayan arka plan programı (ör. Entware'den tailscaled, cron). Yalnız seçili aralıkta en az bir kez çalışmış olanlar listelenir; kullanılmayan arayüzlerin servisleri görünmez. Durum: Durmuş = ayarlarda açık ama çalışmıyor (uyarı gider); Kapalı = ayarlardan kapatılmış, uyarı üretmez; Beklemede = yalnız gerektiğinde çalışan servis (ör. ARP ping check), şu an çalışmıyor, sorun değil. Yeniden başlama = aralıkta süreç numarasının kaç kez değiştiği. Ayarlarda açık bir servis durursa ya da bir süreç kaybolursa 🔴, yeniden başlarsa 🟠 Telegram uyarısı gelir (VPN, PPPoE ve isteğe bağlı çalışanlar hariç; onların kendi uyarıları var).",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 14,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true,
          "expr": "(max by (device, service, kind) (keenetic_service_up == 1) or max by (device, service, kind) ((keenetic_service_up == 0) and on(device, service) (keenetic_service_enabled == 1)) or max by (device, service, kind) ((keenetic_service_up == 0) and on(device, service) (keenetic_service_enabled == 0)) + 3 or max by (device, service, kind) (keenetic_service_up == 0) + 2) and on(device, service) (max_over_time(keenetic_service_up[$__range]) == 1)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true,
          "expr": "max by (device, service, kind) (keenetic_service_memory_bytes) and on(device, service) (max_over_time(keenetic_service_up[$__range]) == 1)"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true,
          "expr": "max by (device, service, kind) (changes(keenetic_service_pid[$__range])) and on(device, service) (max_over_time(keenetic_service_up[$__range]) == 1)"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "device": 0,
              "service": 1,
              "kind": 2,
              "Value #A": 3,
              "Value #B": 4,
              "Value #C": 5
            },
            "renameByName": {
              "device": "Cihaz",
              "service": "Servis",
              "kind": "Tür",
              "Value #A": "Durum",
              "Value #B": "Bellek",
              "Value #C": "Yeniden başlama"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Bellek",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "minWidth": 70
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Cihaz"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 125
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Tür"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 70
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "servis": {
                        "text": "Servis"
                      },
                      "süreç": {
                        "text": "Süreç"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Durum"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 105
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "Çalışıyor",
                        "color": "green"
                      },
                      "0": {
                        "text": "Durmuş",
                        "color": "red"
                      },
                      "2": {
                        "text": "Beklemede",
                        "color": "text"
                      },
                      "3": {
                        "text": "Kapalı",
                        "color": "text"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Bellek"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Yeniden başlama"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 125
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 63,
      "type": "timeseries",
      "title": "Bellek kullanımı (en yüksek 8)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Süreç başına bellek (RSS). Sürekli artan bir çizgi bellek sızıntısına işaret eder. Ana router'da en çok bellek kullananlar genelde tailscaled, Trafik İzleme (Ntce::Manager) ve ndm'dir.",
