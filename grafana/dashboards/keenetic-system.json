        "x": 14,
        "y": 32,
        "w": 10,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(8, keenetic_service_memory_bytes)",
          "legendFormat": "{{service}} ({{device}})"
