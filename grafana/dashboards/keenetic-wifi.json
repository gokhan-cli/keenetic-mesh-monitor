    {
      "id": 48,
      "type": "table",
      "title": "Son olaylar",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 14,
        "h": 10
      },
      "description": "Router'ın mesh dolaşım günlüğünden son 100 olay. Dolaşım = istemci erişim noktası (ya da bant) değiştirdi; Bağlandı / Ayrıldı = Wi-Fi'a bağlandı ya da koptu. Yöntem: Hızlı (802.11r) kesintisiz geçiştir; PMK önbelleği de hızlıdır ama yeniden el sıkışma yapar.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "keenetic_mesh_roam_event * 1000",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "id": true,
              "mac": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "Value": 0,
              "name": 1,
              "event": 2,
              "from": 3,
              "to": 4,
              "method": 5
            },
            "renameByName": {
              "Value": "Zaman",
              "name": "İstemci",
              "event": "Olay",
              "from": "Nereden",
              "to": "Nereye",
              "method": "Yöntem"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Zaman",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "minWidth": 60
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Zaman"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocalNoDateIfToday"
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "İstemci"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Olay"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 95
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "roam": {
                        "text": "Dolaşım",
                        "color": "blue"
                      },
                      "join": {
                        "text": "Bağlandı",
                        "color": "green"
                      },
                      "leave": {
                        "text": "Ayrıldı",
                        "color": "orange"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Yöntem"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ft": {
                        "text": "Hızlı (802.11r)"
                      },
                      "pmk": {
                        "text": "PMK önbelleği"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 49,
      "type": "table",
      "title": "İstemci başına (seçili aralık)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 14,
        "y": 44,
        "w": 10,
        "h": 10
      },
      "description": "Seçili zaman aralığında istemci başına dolaşım, bağlanma ve kopma sayısı. Çok sayıda dolaşım (ör. saatte 10+) cihazın iki erişim noktası arasında gidip geldiğini (ping-pong) gösterir; genelde iki noktanın sinyali o yerde eşit olduğunda olur. Sayım exporter açıldıktan sonraki olaylardır.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum by (name) (increase(keenetic_mesh_roam_events_total{event=\"roam\"}[$__range])))",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum by (name) (increase(keenetic_mesh_roam_events_total{event=\"join\"}[$__range])))",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum by (name) (increase(keenetic_mesh_roam_events_total{event=\"leave\"}[$__range])))",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "name": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3
            },
            "renameByName": {
              "name": "İstemci",
              "Value #A": "Dolaşım",
              "Value #B": "Bağlanma",
              "Value #C": "Kopma"
            }
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "exclude",
            "match": "all",
            "filters": [
              {
                "fieldName": "Dolaşım",
                "config": {
                  "id": "lowerOrEqual",
                  "options": {
                    "value": 0
                  }
                }
              },
              {
                "fieldName": "Bağlanma",
                "config": {
                  "id": "lowerOrEqual",
                  "options": {
                    "value": 0
                  }
                }
              },
              {
                "fieldName": "Kopma",
                "config": {
                  "id": "lowerOrEqual",
                  "options": {
                    "value": 0
                  }
                }
              }
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Dolaşım",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "minWidth": 60
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "İstemci"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
