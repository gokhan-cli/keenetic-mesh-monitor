    {
      "id": 65,
      "type": "stat",
      "title": "Saldıran IP (seçili aralık)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Router günlüğünde engellenen ya da kötü niyetli istek yapan farklı IP sayısı.",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(max by (ip) (max_over_time(keenetic_security_ip_last_seen_seconds[$__range]) > time() - $__range_s)) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "links": [
            {
              "title": "Güvenlik panosunu aç",
              "url": "/d/keenetic-security?${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
