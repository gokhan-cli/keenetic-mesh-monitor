    {
      "id": 7,
      "type": "table",
      "title": "Mesh üyeleri",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "keenetic_mesh_member_info",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "name": "Ad",
              "mac": "MAC",
              "model": "Model",
              "ip": "IP",
              "firmware": "Yazılım",
              "uplink": "Bağlantı",
              "mode": "Standart",
              "security": "Güvenlik"
            },
            "indexByName": {
              "name": 0,
              "model": 1,
              "ip": 2,
              "mac": 3,
              "firmware": 4,
              "uplink": 5,
              "mode": 6,
              "security": 7
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "uplink"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^WifiMaster0/.*",
                      "result": {
                        "text": "Kablosuz (2.4 GHz)"
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^WifiMaster1/.*",
                      "result": {
                        "text": "Kablosuz (5 GHz)"
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^WifiMaster2/.*",
                      "result": {
                        "text": "Kablosuz (5 GHz-2)"
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^(Gigabit|Ten|Fast)?Ethernet.*|^ISP$",
                      "result": {
                        "text": "Kablolu"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "mode"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "11be": {
                        "text": "Wi-Fi 7 (802.11be)"
                      },
                      "11ax": {
                        "text": "Wi-Fi 6 (802.11ax)"
                      },
                      "11ac": {
                        "text": "Wi-Fi 5 (802.11ac)"
                      },
                      "11n": {
                        "text": "Wi-Fi 4 (802.11n)"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "security"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "wpa3-psk": {
                        "text": "WPA3-Kişisel"
                      },
                      "wpa2-psk": {
                        "text": "WPA2-Kişisel"
                      },
                      "wpa2-wpa3-psk": {
                        "text": "WPA2/WPA3-Kişisel"
                      },
                      "wpa3-sae": {
                        "text": "WPA3-Kişisel"
                      },
                      "owe": {
                        "text": "Açık (OWE şifreli)"
                      },
                      "none": {
                        "text": "Açık (şifresiz)"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 64,
