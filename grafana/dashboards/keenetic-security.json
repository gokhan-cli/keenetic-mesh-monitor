    {
      "id": 37,
      "type": "table",
      "title": "Saldıran IP'ler (router günlüğü)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Router günlüklerinden (her cihazda Tanılama → Sistem Günlüğü): giriş korumasının engellediği IP'ler (\"ban remote host\") ve router'ın kötü niyetli saydığı istekler (\"malicious request\"). Üstteki zaman aralığına göre süzülür: yalnız o aralıkta görülen IP'ler listelenir, Engelleme ve Kötü istek o aralıktaki sayılardır. Son istekler IP başına son 5 yoldur. IP'ye tıklayınca AbuseIPDB'de açılır.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (device, ip) (max_over_time(keenetic_security_ip_last_seen_seconds[$__range]) > time() - $__range_s) * 1000",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_min(max by (device, ip) (max_over_time(keenetic_security_ip_bans[$__range]) - (keenetic_security_ip_bans offset $__range or max_over_time(keenetic_security_ip_bans[$__range]) * 0)), 0) and on(device, ip) (max_over_time(keenetic_security_ip_last_seen_seconds[$__range]) > time() - $__range_s)",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "clamp_min(max by (device, ip) (max_over_time(keenetic_security_ip_malicious_requests[$__range]) - (keenetic_security_ip_malicious_requests offset $__range or max_over_time(keenetic_security_ip_malicious_requests[$__range]) * 0)), 0) and on(device, ip) (max_over_time(keenetic_security_ip_last_seen_seconds[$__range]) > time() - $__range_s)",
          "format": "table",
          "instant": true
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (device, ip, protocol, paths) (keenetic_security_ip_info) and on(device, ip) (max_over_time(keenetic_security_ip_last_seen_seconds[$__range]) > time() - $__range_s)",
          "format": "table",
          "instant": true
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (device, ip) (max_over_time(keenetic_security_ban_until_seconds[$__range])) * 1000 and on(device, ip) (max_over_time(keenetic_security_ip_last_seen_seconds[$__range]) > time() - $__range_s)",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #D": true
            },
            "indexByName": {
              "Value #A": 0,
              "device": 1,
              "ip": 2,
              "protocol": 3,
              "Value #B": 4,
              "Value #C": 5,
              "Value #E": 6,
              "paths": 7
            },
            "renameByName": {
