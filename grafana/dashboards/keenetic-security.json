    {
      "id": 60,
      "type": "table",
      "title": "Yönetici girişleri (router günlüğü)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Router günlüklerindeki \"started a user session\" satırları; exporter'ın kendi kullanıcısı ve router'ın iç oturumları hariç. Üstteki zaman aralığında görülen girişler; aynı kullanıcı, adres ve tarayıcı tek satırda, son giriş zamanıyla. Kaynak: İnternet = router'a internetten (ör. PPPoE0 üzerinden) giriş, Telegram'a 🔴 uyarı gider; Yerel ağ = ev ağından ya da VPN'den, 🟠 uyarı gider; Keenetic bulutu = mobil uygulama ve uzaktan yönetim: gerçek IP görünmez (bulut sunucusunun adresi görünür) ve sık oturum açtığı için uyarı üretmez. IP'ye tıklayınca AbuseIPDB'de açılır.",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true,
          "expr": "max by (device, user, ip, interface, client, scope) (max_over_time(keenetic_admin_login_seconds[$__range]) > time() - $__range_s) * 1000"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "Value": 0,
              "scope": 1,
              "device": 2,
              "user": 3,
              "ip": 4,
              "interface": 5,
              "client": 6
            },
            "renameByName": {
              "Value": "Son giriş",
              "scope": "Kaynak",
              "device": "Cihaz",
              "user": "Kullanıcı",
              "ip": "IP",
              "interface": "Arayüz",
              "client": "İstemci"
            }
          }
        },
        {
