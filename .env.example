# Controller Keenetic adresi
KEENETIC_HOST=http://192.168.1.1
# Router'da bu iş için açılan ayrı kullanıcı
KEENETIC_LOGIN=monitor
KEENETIC_PASSWORD=degistir
# Wi-Fi istemcilerini topla (controller + mesh üyeleri) ve okuma aralığı (sn)
COLLECT_CLIENTS=true
CLIENTS_INTERVAL=30
# Grafana yönetici şifresi
GF_ADMIN_PASSWORD=degistir
# Çevredeki Wi-Fi ağlarını taranacak radyolar (boş = kapalı) ve tarama aralığı (sn)
SITE_SURVEY_INTERFACES=WifiMaster0,WifiMaster1
SITE_SURVEY_INTERVAL=300
# Durumu izlenecek radyolar (boş = kapalı) ve okuma aralığı (sn)
RADIO_INTERFACES=WifiMaster0,WifiMaster1
RADIO_INTERVAL=60
# Yazılım güncellemesi kontrol aralığı (sn, 0 = kapalı)
FIRMWARE_INTERVAL=3600
# Sistem Güvenliği sayaçları (giriş koruması, DoS) okuma aralığı (sn, 0 = kapalı)
SECURITY_INTERVAL=60
# Cihaz başına CPU / bellek / açık kalma süresi okuma aralığı (sn, 0 = kapalı)
SYSTEM_INTERVAL=30
# Mesh dolaşım günlüğü okuma aralığı (sn, 0 = kapalı)
ROAM_INTERVAL=60
# Uygulama bazında trafik okuma aralığı (sn, en fazla 150, 0 = kapalı)
APP_INTERVAL=60
# Servis / süreç durumu okuma aralığı (sn, 0 = kapalı)
SERVICE_INTERVAL=60
# Router'ların uzak syslog'u (engellenen IP'ler) için UDP port (0 = kapalı).
# Router'da Diagnostik → Sistem günlüğü → uzak sunucu: bu makinenin IP'si
SYSLOG_PORT=514
# Telegram uyarıları için bot token'ı (@BotFather). Sohbet numarası
# grafana/provisioning/alerting/telegram.yml içinde (chatid; bkz. README)
TELEGRAM_BOT_TOKEN=
